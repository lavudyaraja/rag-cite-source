# Neon PostgreSQL (pgvector required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini — embeddings + primary chat
GEMINI_API_KEY=your_gemini_api_key

# Optional: NVIDIA Qwen fallback when Gemini fails / quota exceeded
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_CHAT_MODEL=qwen/qwen3.5-397b-a17b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional: extra LLM call per query for search expansion (default: off)
ENABLE_QUERY_EXPANSION=false

# Optional: override Gemini chat model
# GEMINI_CHAT_MODEL=gemini-2.5-flash
